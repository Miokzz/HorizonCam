<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CameraControl" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/camera_control_text</item>
        <item name="backgroundTint">@color/camera_control_background</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconTint">@color/camera_control_text</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">22dp</item>
    </style>
    <style name="CameraMode" parent="CameraControl">
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="backgroundTint">@color/camera_mode_background</item>
    </style>
</resources>
