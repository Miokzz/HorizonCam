<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <androidx.camera.view.PreviewView
        android:id="@+id/photoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter"
        app:implementationMode="performance" />

    <View
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:layout_gravity="top"
        android:background="@drawable/top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="205dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToVideoButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="‹  VÍDEO"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#9E151515"
            app:cornerRadius="22dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="HORIZONCAM  /  FOTO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="125dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lens06Button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="62dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="5dp"
            android:text="0,6×"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="#A6181818"
            app:cornerRadius="23dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lens1Button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="62dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="5dp"
            android:text="1×"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="#A6181818"
            app:cornerRadius="23dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lens3Button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="62dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="5dp"
            android:text="3×"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="#A6181818"
            app:cornerRadius="23dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lensStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="186dp"
        android:gravity="center"
        android:text="PRINCIPAL • 1×"
        android:textColor="#DDFFFFFF"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/shutterButton"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="25dp"
        android:background="@drawable/record_outer"
        android:clickable="true"
        android:contentDescription="Tirar foto"
        android:focusable="true">

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/photo_shutter" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/galleryButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="92dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="44dp"
        android:text="GALERIA"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        app:backgroundTint="#9E151515"
        app:cornerRadius="22dp" />

</FrameLayout>
